{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Mike-Autodownload",
  "description": "__MSG_appDesc__",
  "version": "2.1.0",
  "icons": {
    "16": "icons/mike-16.png",
    "32": "icons/mike-32.png",
    "48": "icons/mike-48.png",
    "128": "icons/mike-128.png"
  },
  "action": {
    "default_title": "Mike-Autodownload",
    "default_icon": {
      "16": "icons/mike-16.png",
      "32": "icons/mike-32.png",
      "48": "icons/mike-48.png",
      "128": "icons/mike-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://so9.vn/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://snaptik.app/*",
    "https://ssstik.io/*",
    "https://snapsave.app/*",
    "https://snapinsta.app/*",
    "https://snapdouyin.app/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.savefrom.net/*",
    "https://snapany.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://so9.vn/9downloader/*",
        "https://snaptik.app/*",
        "https://ssstik.io/*",
        "https://snapsave.app/*",
        "https://snapinsta.app/*",
        "https://snapdouyin.app/*",
        "https://*.savefrom.net/*",
        "https://snapany.com/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "default_locale": "vi"
}
