{
  "name": "mike-autodownload",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Static contract checks for the Mike-Autodownload Chrome extension.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check:syntax": "node tools/check-syntax.mjs",
    "check": "npm run check:syntax && npm test",
    "zip": "cd src && powershell -NoProfile -Command \"Compress-Archive -Force -Path * -DestinationPath ../Mike-Autodownload.zip\""
  },
  "engines": {
    "node": ">=22"
  }
}
